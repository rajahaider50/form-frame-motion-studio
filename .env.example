# Manus OAuth application settings (never use real secrets in this file)
MANUS_PROJECT_ID=your_manus_project_id
MANUS_OAUTH_PORTAL_URL=https://auth.example.com
MANUS_OAUTH_API_URL=https://api.example.com

# Owner-selected site administrators: case-insensitive emails and/or stable OpenIDs.
ADMIN_ALLOWED_EMAILS=you@example.com
ADMIN_ALLOWED_OPEN_IDS=
ADMIN_SESSION_SECRET=replace_with_a_random_48_byte_secret

# Optional: needed only to validate a Preview-injected platform HS256 session.
MANUS_JWT_SECRET=

# Upstash Redis REST / Vercel KV-compatible durable storage (required in serverless production).
# Local development may omit both values and use ignored JSON files under ./data.
KV_REST_API_URL=
KV_REST_API_TOKEN=
